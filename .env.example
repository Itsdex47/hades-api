# H.A.D.E.S. API Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# CORE APPLICATION
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# SECURITY & AUTHENTICATION (REQUIRED)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# Optional: For refresh tokens
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Optional: For encrypting sensitive data
ENCRYPTION_KEY=your_encryption_key_here

# ============================================
# DATABASE (REQUIRED)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# CORS & FRONTEND
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# PAYMENT RAILS (At least one required)
# ============================================

# Stripe (Traditional payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Circle (USDC & Compliance)
CIRCLE_API_KEY=your_circle_api_key
CIRCLE_WALLET_ID=your_circle_wallet_id
CIRCLE_ENVIRONMENT=sandbox

# Alchemy (Blockchain infrastructure)
ALCHEMY_API_KEY=your_alchemy_api_key
ALCHEMY_NETWORK=eth-mainnet

# Solana (Blockchain payments)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=your_base64_encoded_private_key
SOLANA_USDC_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr

# ============================================
# MONITORING & ANALYTICS (Optional)
# ============================================
SENTRY_DSN=your_sentry_dsn
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_HOST=https://app.posthog.com

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_MULTI_RAIL=true
ENABLE_COMPLIANCE_MONITORING=true
ENABLE_DEMO_MODE=false
ENABLE_KYC_BYPASS=false

# ============================================
# TRANSACTION LIMITS
# ============================================
MAX_TRANSACTION_AMOUNT_USD=10000
MIN_TRANSACTION_AMOUNT_USD=1

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ============================================
# DEMO & TESTING (Optional)
# ============================================
# Set to true to use demo credentials in development
USE_DEMO_CREDENTIALS=false
